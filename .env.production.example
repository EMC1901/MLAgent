# ── Database ──
DATABASE_URL=postgresql://mlagent:<生成一个强密码>@db:5432/mlagent

# ── App ──
APP_NAME=MLAgent
APP_ENV=production
DEBUG=False
CORS_ORIGINS=["https://你的域名或IP"]

# ── LLM (DashScope / OpenAI-compatible) ──
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_API_KEY=<你的API Key>
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=300
LLM_CALL_COOLDOWN_SECONDS=20

# ── Upload & Artifacts ──
DATASET_UPLOAD_DIR=/app/uploads
FEATURE_ARTIFACT_DIR=/app/artifacts/features
MODEL_READY_ARTIFACT_DIR=/app/artifacts/model_ready

# ── Optional: customize HPO / feature engineering limits ──
# MODEL_CONTEXT_MAX_HPO_TRIALS=50
# MAX_FEATURE_DIMENSION=2000
